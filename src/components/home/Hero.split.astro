---
import { whatsappLink } from '../../lib/empresa';
---

<section class="bg-gfl-bg-soft relative overflow-hidden">
  <div class="container mx-auto px-4 py-12 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <div class="lg:col-span-7 order-2 lg:order-1">
        <div
          class="inline-flex items-center gap-2 px-3 py-1.5 bg-gfl-midea rounded text-xs font-semibold tracking-wider mb-6 uppercase"
          style="color: white;"
        >
          <span class="text-base font-bold">)</span> Centro de Serviços Autorizado
        </div>

        <h1
          class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight leading-[1.05] mb-6 text-gfl-text"
        >
          PMOC e manutenção HVAC<br />
          <span class="text-gfl-midea">no Vale e Campinas</span>
        </h1>

        <p class="text-base md:text-lg text-gfl-text-muted leading-relaxed mb-8 max-w-xl">
          Autorizada oficial <strong class="text-gfl-carrier">Midea Blue Service</strong> e
          <strong class="text-gfl-carrier">Carrier</strong>. Plano de Manutenção, Operação e
          Controle conforme Lei 13.589/2018, atendendo +30 cidades em 2 regiões.
        </p>

        <div class="flex flex-wrap gap-3 mb-8">
          <a
            href="/pmoc"
            class="bg-gfl-midea hover:bg-gfl-midea-hover px-7 py-3.5 rounded font-semibold text-sm md:text-base transition-colors"
            style="color: white;"
          >
            Solicite diagnóstico PMOC
          </a>
          <a
            href={whatsappLink('Olá, vim do site e quero falar com um técnico.')}
            target="_blank"
            rel="noopener"
            class="bg-white text-gfl-carrier border border-gfl-carrier hover:bg-gfl-carrier hover:text-white px-7 py-3.5 rounded font-semibold text-sm md:text-base transition-colors"
          >
            Falar pelo WhatsApp
          </a>
        </div>

        <div class="flex items-center gap-3 pt-5 border-t border-gfl-border-soft">
          <div class="flex items-center gap-1 text-gfl-warning">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path
                d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
              ></path>
            </svg>
            <span class="font-bold text-sm text-gfl-text ml-1">4,7</span>
          </div>
          <span class="text-sm text-gfl-text-muted">189 avaliações no Google</span>
        </div>
      </div>

      <div class="lg:col-span-5 order-1 lg:order-2 relative">
        <div
          class="relative aspect-[3/4] lg:aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl ring-1 ring-gfl-border-soft"
        >
          <img
            src="/images/fachada/fachada-hero.jpg"
            alt="Fachada da GFL Service & Repair - Centro de Serviços Autorizado Midea Carrier em São José dos Campos"
            class="w-full h-full object-cover"
          />
        </div>
        <div
          class="hidden md:block absolute -bottom-4 -right-4 bg-gfl-midea text-white px-4 py-3 rounded-lg shadow-xl"
          style="z-index: 2;"
        >
          <div class="text-xs font-semibold tracking-wide uppercase opacity-80">Nossa sede</div>
          <div class="text-sm font-bold">SJC · Vale do Paraíba</div>
        </div>
      </div>
    </div>
  </div>
</section>
