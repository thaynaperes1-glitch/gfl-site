---
import { whatsappLink } from '../../lib/empresa';
---

<section class="bg-gfl-bg py-12" data-reveal>
  <div class="container mx-auto px-4 text-center max-w-2xl">
    <h2 class="text-2xl md:text-3xl font-bold text-gfl-text mb-3">
      Pronto para uma manutenção autorizada?
    </h2>
    <p class="text-gfl-text-muted mb-6">
      Fale com nossa equipe técnica e receba um diagnóstico inicial em até 24h.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a
        href="/contato"
        class="bg-gfl-midea hover:bg-gfl-midea-hover text-white px-6 py-3 rounded font-semibold text-sm transition-colors"
      >
        Solicitar orçamento
      </a>
      <a
        href={whatsappLink('Olá, gostaria de falar com a equipe técnica.')}
        target="_blank"
        rel="noopener"
        class="bg-white text-gfl-carrier border border-gfl-carrier hover:bg-gfl-carrier hover:text-white px-6 py-3 rounded font-semibold text-sm transition-colors"
      >
        WhatsApp direto
      </a>
    </div>
  </div>
</section>
